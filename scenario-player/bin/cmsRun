#!/usr/bin/env python3
"""
(FAKE) stand-in for CMSSW's `cmsRun`.

Reads the `# FAKE_OUTPUTS=...` marker scenario-player/bin/cmsDriver.py wrote into the given
python config and creates each listed output file in the current directory, so
the calling bash script's `if cmsRun ...; then mv/touch ...` success path has
real files to work with. Each output is a provenance manifest (scenario-player/fake_conddb.py)
naming the lumisections the job's `# FAKE_INPUTS=...` actually carried.

Before doing any of that, checks $NGT_FAULTS_DIR/cmsrun.json (armed by
scenario-player/seed.py's arm_fault(), called by scenario-player/scenario_player.py for a scenario's
`faults:` entries, or directly via `scenario-player/seed.py arm-fault`) for a
still-armed, scope-matching simulated failure, and if one exists, prints a
CMSSW-style "Fatal Exception" banner to stderr and exits with the configured
code instead -- realistic enough that debugging it via the job's stdout/
stderr log is a reasonable stand-in for debugging a genuine CMSSW crash.
Scope (calibration/run/step) is derived from the current working directory --
see _scope_from_cwd -- since NGTLoopStep2/3/4.py always run this job with cwd
set to their own <calibration>/run<N>[/<jobDir>] working directory.
"""
import os
import re
import sys
import time

# env.sh puts this checkout's scenario-player/bin on $PATH, so scenario-player/faults.py and
# fake_conddb.py are always one directory up.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import fake_conddb  # noqa: E402
import faults  # noqa: E402


def _scope_from_cwd():
    """{calibration, run, step} derived from cwd: step2 runs directly in
    <data_base_path>/<calibration>/run<N>/; step3/step4 nest a job dir one level
    deeper, alcaPromptJob*/harvestJob* (NGTLoopStep3/4.py number them:
    alcaPromptJob000, harvestJob000, ...)."""
    parts = os.getcwd().replace("\\", "/").rstrip("/").split("/")
    scope = {"calibration": None, "run": None, "step": None}
    for i, part in enumerate(parts):
        m = re.match(r"^run(\d+)$", part)
        if m:
            scope["run"] = m.group(1)
            if i > 0:
                scope["calibration"] = parts[i - 1]
            break
    basename = parts[-1] if parts else ""
    if re.match(r"^run\d+$", basename):
        scope["step"] = "step2"
    elif basename.startswith("alcaPromptJob"):
        scope["step"] = "step3"
    elif basename.startswith("harvestJob"):
        scope["step"] = "step4"
    return scope


def _check_fault():
    faults_dir = os.environ.get("NGT_FAULTS_DIR")
    if not faults_dir:
        return None
    path = os.path.join(faults_dir, "cmsrun.json")
    with faults.locked_json_file(path):
        return faults.consume_fault(path, _scope_from_cwd())


# Real-looking detail per exit code, so an injected failure resembles the genuine CMSSW error.
_CANNED_DETAIL = {
    139: "A fatal system signal has occurred: segmentation violation",
    134: "An OS signal was sent to the process: SIGABRT (signal 6)",
    127: "cmsRun: command not found",
}


def _fatal_exception_banner(exit_code):
    """CMSSW's "Fatal Exception" banner, filled in from the exit code, the job's scope and the time."""
    category = "FatalRootError" if exit_code in (139, 134) else "StdException"
    detail = _CANNED_DETAIL.get(exit_code, f"injected failure, exit code {exit_code}")
    scope = _scope_from_cwd()
    context = f"run: {scope['run']} calibration: {scope['calibration']}"
    return (
        f"----- Begin Fatal Exception {time.strftime('%d-%b-%Y %H:%M:%S %Z')} -----------------------\n"
        f"An exception of category '{category}' occurred while\n"
        f"   [0] Processing  {context}\n"
        "   [1] Running path 'alcaHarvesting'\n"
        "Exception Message:\n"
        f"{detail}\n"
        "----- End Fatal Exception -------------------------------------"
    )


def main():
    fault = _check_fault()
    if fault:
        exit_code = fault.get("exit_code", 1)
        print(f"(FAKE) cmsRun: injected failure (mode={fault['mode']}) -- exiting {exit_code}", file=sys.stderr)
        print(_fatal_exception_banner(exit_code), file=sys.stderr)
        sys.exit(exit_code)

    if len(sys.argv) < 2:
        print("(FAKE) cmsRun: expected a python config filename", file=sys.stderr)
        sys.exit(1)

    python_filename = sys.argv[1]
    try:
        with open(python_filename, "r", encoding="utf-8") as f:
            content = f.read()
    except FileNotFoundError:
        print(f"(FAKE) cmsRun: {python_filename} not found", file=sys.stderr)
        sys.exit(1)

    match = re.search(r"# FAKE_OUTPUTS=(.*)", content)
    outputs = [o for o in (match.group(1).split(",") if match else []) if o]

    if not outputs:
        print(f"(FAKE) cmsRun: no FAKE_OUTPUTS marker in {python_filename}", file=sys.stderr)
        sys.exit(1)

    match = re.search(r"# FAKE_INPUTS=(.*)", content)
    inputs = [i for i in (match.group(1).split(",") if match else []) if i]

    # Derived from the actual inputs, never from the scenario: feed a harvest the wrong files and
    # its payload is wrong too.
    scope = _scope_from_cwd()
    lumisections = fake_conddb.merge_input_lumisections(inputs)
    for output in outputs:
        fake_conddb.write_provenance(output, lumisections=lumisections, inputs=inputs, **scope)

    ls_summary = ",".join(str(ls) for ls in sorted(lumisections)) or "none"
    print(f"(FAKE) cmsRun: ran {python_filename}, wrote {outputs} covering LS {ls_summary}")


if __name__ == "__main__":
    main()
