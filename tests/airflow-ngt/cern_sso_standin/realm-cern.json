{
  "realm": "cern",
  "enabled": true,
  "clients": [
    {
      "clientId": "ngt-airflow",
      "secret": "not-a-secret",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:18293/auth/oauth-authorized/cern"],
      "protocolMappers": [
        {
          "name": "cern_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "claim.name": "cern_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "usermodel.clientRoleMapping.clientId": "ngt-airflow",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "ngt-airflow": [{"name": "default-role"}, {"name": "admin"}]
    }
  },
  "users": [
    {
      "username": "an-admin",
      "enabled": true,
      "email": "an-admin@example.invalid",
      "firstName": "An",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "an-admin"}],
      "clientRoles": {"ngt-airflow": ["default-role", "admin"]}
    },
    {
      "username": "a-viewer",
      "enabled": true,
      "email": "a-viewer@example.invalid",
      "firstName": "A",
      "lastName": "Viewer",
      "credentials": [{"type": "password", "value": "a-viewer"}],
      "clientRoles": {"ngt-airflow": ["default-role"]}
    }
  ]
}
